# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://invoice_app:change-me@localhost:5432/invoice_management?schema=public
POSTGRES_DB=invoice_management
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
APP_PORT=3000

# Authentication (generate long random values; never reuse these examples in production)
SESSION_COOKIE_NAME=invoice_session
SESSION_TTL_HOURS=12
SESSION_SECRET=replace-with-at-least-32-random-characters
# local | oidc | hybrid
AUTH_PROVIDER=local

# OpenID Connect Authorization Code + PKCE (required for oidc/hybrid)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_DISPLAY_NAME=ورود یکپارچه سازمانی
# Keep false unless the identity provider guarantees verified email claims.
OIDC_AUTO_PROVISION=false

# Base64 encoded 32-byte AES key. Example generator:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BANK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
BANK_ENCRYPTION_KEY_ID=local-v1

# Private file archive
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
UPLOAD_MAX_FILE_BYTES=10485760

# Initial accounts (used only by `npm run db:seed`)
SEED_DEFAULT_PASSWORD=replace-before-seeding
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_FINANCE_ADMIN_USERNAME=financeadmin

# Optional object storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
